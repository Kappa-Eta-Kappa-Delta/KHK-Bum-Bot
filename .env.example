DISCORD_TOKEN=your-bot-token-here
# Optional: set to your test-guild ID for instant slash-command availability during dev.
# Leave blank to publish globally (takes up to ~1 hour for Discord to propagate).
DISCORD_GUILD_ID=

# Optional: Google Drive upload. Set folder ID and place token.json in the repo root.
# Run setup_drive.py once to generate token.json.
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here
